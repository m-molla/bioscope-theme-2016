{
  "$schema": "https://schemas.wp.org/wp/6.7/theme.json",
  "version": 3,
  "title": "Category Badge",
  "slug": "category-badge",
  "blockTypes": ["core/group", "core/paragraph", "core/post-terms"],
  "styles": {
    "color": {
      "text": "var(--bioscope-gold)",
      "background": "var(--bioscope-gold-pale)"
    },
    "typography": {
      "fontSize": "9px",
      "letterSpacing": "0.35em",
      "textTransform": "uppercase"
    },
    "spacing": {
      "padding": {
        "top": "4px",
        "right": "10px",
        "bottom": "4px",
        "left": "10px"
      }
    },
    "elements": {
      "link": {
        "color": {
          "text": "var(--bioscope-gold)"
        },
        "typography": {
          "textDecoration": "none"
        }
      }
    },
    "css": "display: inline-block !important;"
  }
}
