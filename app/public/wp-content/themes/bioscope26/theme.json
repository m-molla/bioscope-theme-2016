{
  "$schema": "https://schemas.wp.org/wp/6.7/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "100%",
      "wideSize": "100%"
    },
    "color": {
      "defaultPalette": false,
      "palette": [
        {
          "slug": "background",
          "color": "var(--bioscope-background)",
          "name": "Background"
        },
        {
          "slug": "surface",
          "color": "var(--bioscope-surface)",
          "name": "Surface"
        },
        {
          "slug": "surface-alt",
          "color": "var(--bioscope-surface-alt)",
          "name": "Surface Alt"
        },
        {
          "slug": "text",
          "color": "var(--bioscope-text)",
          "name": "Text"
        },
        {
          "slug": "muted",
          "color": "var(--bioscope-muted)",
          "name": "Muted"
        },
        {
          "slug": "gold",
          "color": "var(--bioscope-gold)",
          "name": "Gold"
        },
        {
          "slug": "gold-light",
          "color": "var(--bioscope-gold-light)",
          "name": "Gold Light"
        },
        {
          "slug": "gold-pale",
          "color": "var(--bioscope-gold-pale)",
          "name": "Gold Pale"
        },
        {
          "slug": "border",
          "color": "var(--bioscope-border)",
          "name": "Border"
        },
        {
          "slug": "border-soft",
          "color": "var(--bioscope-border-soft)",
          "name": "Border Soft"
        },
        {
          "slug": "footer",
          "color": "var(--bioscope-footer)",
          "name": "Footer"
        },
        {
          "slug": "white-full",
          "color": "rgba(255,255,255,1)",
          "name": "White"
        },
        {
          "slug": "white-48",
          "color": "rgba(255,255,255,0.48)",
          "name": "White 48"
        },
        {
          "slug": "white-33",
          "color": "rgba(255,255,255,0.33)",
          "name": "White 33"
        },
        {
          "slug": "button-primary",
          "color": "var(--bioscope-button-primary)",
          "name": "Button Primary"
        },
        {
          "slug": "button-primary-hover",
          "color": "var(--bioscope-button-primary-hover)",
          "name": "Button Primary Hover"
        },
        {
          "slug": "button-secondary-hover",
          "color": "var(--bioscope-button-secondary-hover)",
          "name": "Button Secondary Hover"
        },
        {
          "slug": "button-secondary-border",
          "color": "var(--bioscope-button-secondary-border)",
          "name": "Button Secondary Border Color"
        },
        {
          "slug": "button-secondary-border-hover",
          "color": "var(--bioscope-button-secondary-border-hover)",
          "name": "Button Secondary Border hovers Color"
        }
      ]
    },
    "typography": {
      "customFontSize": true,
      "fluid": true,
      "fontFamilies": [
        {
          "fontFamily": "\"Cormorant Garamond\", serif",
          "name": "Cormorant Garamond",
          "slug": "cormorant-garamond",
          "fontFace": [
            {
              "fontFamily": "Cormorant Garamond",
              "fontStyle": "normal",
              "fontWeight": "300",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/CormorantGaramond-Light.woff2",
                "file:./assets/fonts/CormorantGaramond-Light.woff"
              ]
            },
            {
              "fontFamily": "Cormorant Garamond",
              "fontStyle": "normal",
              "fontWeight": "400",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/CormorantGaramond-Regular.woff2",
                "file:./assets/fonts/CormorantGaramond-Regular.woff"
              ]
            },
            {
              "fontFamily": "Cormorant Garamond",
              "fontStyle": "normal",
              "fontWeight": "500",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/CormorantGaramond-Medium.woff2",
                "file:./assets/fonts/CormorantGaramond-Medium.woff"
              ]
            },
            {
              "fontFamily": "Cormorant Garamond",
              "fontStyle": "italic",
              "fontWeight": "300",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/CormorantGaramond-LightItalic.woff2",
                "file:./assets/fonts/CormorantGaramond-LightItalic.woff"
              ]
            },
            {
              "fontFamily": "Cormorant Garamond",
              "fontStyle": "italic",
              "fontWeight": "400",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/CormorantGaramond-Italic.woff2",
                "file:./assets/fonts/CormorantGaramond-Italic.woff"
              ]
            }
          ]
        },
        {
          "fontFamily": "\"DM Sans\", sans-serif",
          "name": "DM Sans",
          "slug": "dm-sans",
          "fontFace": [
            {
              "fontFamily": "DM Sans",
              "fontStyle": "light",
              "fontWeight": "300",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/DMSans-Light.woff2",
                "file:./assets/fonts/DMSans-Light.woff"
              ]
            },

            {
              "fontFamily": "DM Sans",
              "fontStyle": "normal",
              "fontWeight": "400",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/DMSans-Regular.woff2",
                "file:./assets/fonts/DMSans-Regular.woff"
              ]
            },
            {
              "fontFamily": "DM Sans",
              "fontStyle": "normal",
              "fontWeight": "500",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/DMSans-Medium.woff2",
                "file:./assets/fonts/DMSans-Medium.woff"
              ]
            },
            {
              "fontFamily": "DM Sans",
              "fontStyle": "italic",
              "fontWeight": "500",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/DMSans-MediumItalic.woff2",
                "file:./assets/fonts/DMSans-MediumItalic.woff"
              ]
            }
          ]
        }
      ],
      "fontSizes": [
        {
          "slug": "bioscope-x-small",
          "name": "Extra Small",
          "size": "10px",
          "fluid": false
        },
        {
          "slug": "bioscope-small",
          "name": "Small",
          "size": "15px",
          "fluid": {
            "min": "13px",
            "max": "15px"
          }
        },
        {
          "slug": "bioscope-medium",
          "name": "Medium",
          "size": "24px",
          "fluid": {
            "min": "22px",
            "max": "24px"
          }
        },
        {
          "slug": "bioscope-large",
          "name": "Large",
          "size": "28px",
          "fluid": {
            "min": "20px",
            "max": "28px"
          }
        },
        {
          "slug": "bioscope-x-large",
          "name": "Extra Large",
          "size": "36px",
          "fluid": {
            "min": "28px",
            "max": "40px"
          }
        },
        {
          "slug": "bioscope-section-title",
          "name": "Section Title",
          "size": "58px",
          "fluid": {
            "min": "32px",
            "max": "58px"
          }
        },
        {
          "slug": "bioscope-big-title",
          "name": "Big Title",
          "size": "64px",
          "fluid": {
            "min": "40px",
            "max": "112px"
          }
        },
        {
          "slug": "bioscope-cta-title",
          "name": "CTA Title",
          "size": "64px",
          "fluid": {
            "min": "40px",
            "max": "90px"
          }
        }
      ]
    },
    "spacing": {
      "padding": true,
      "margin": true,
      "blockGap": true,
      "units": ["px", "em", "rem", "%", "vw", "vh"]
    },
    "viewport": {
      "mobile": "639px",
      "tablet": "1024px"
    }
  },
  "styles": {
    "color": {
      "text": "var:preset|color|text",
      "background": "var:preset|color|background"
    },
    "typography": {
      "fontFamily": "var:preset|font-family|dm-sans",
      "fontSize": "var:preset|font-size|bioscope-medium",
      "lineHeight": "1.6"
    },
    "elements": {
      "h1": {
        "typography": {
          "fontFamily": "var:preset|font-family|cormorant-garamond",
          "fontSize": "var:preset|font-size|bioscope-x-large",
          "lineHeight": "1.1",
          "fontWeight": "400"
        }
      },
      "h2": {
        "typography": {
          "fontFamily": "var:preset|font-family|cormorant-garamond",
          "lineHeight": "1.15",
          "fontWeight": "400"
        }
      },
      "h3": {
        "typography": {
          "fontFamily": "var:preset|font-family|cormorant-garamond",
          "lineHeight": "1.2",
          "fontWeight": "400"
        }
      },
      "h4": {
        "typography": {
          "fontFamily": "var:preset|font-family|cormorant-garamond",
          "fontWeight": "400"
        }
      },
      "h5": {
        "typography": {
          "fontFamily": "var:preset|font-family|cormorant-garamond",
          "fontWeight": "400"
        }
      },
      "h6": {
        "typography": {
          "fontFamily": "var:preset|font-family|cormorant-garamond",
          "fontWeight": "400"
        }
      },
      "link": {
        "color": {
          "text": "var:preset|color|text"
        }
      }
    },
    "blocks": {
      "core/heading": {
        "typography": {
          "fontFamily": "var:preset|font-family|cormorant-garamond"
        }
      },
      "core/button": {
        "color": {
          "background": "var:preset|color|button-primary",
          "text": "var:preset|color|white"
        },

        "border": {
          "radius": "0px"
        },

        "typography": {
          "fontSize": "var:preset|font-size|bioscope-x-small",
          "letterSpacing": "0.3em",
          "textTransform": "uppercase",
          "lineHeight": "1.3"
        },

        "spacing": {
          "padding": {
            "top": "14px",
            "right": "36px",
            "bottom": "14px",
            "left": "36px"
          },
          "margin": {
            "margin": "0"
          }
        },

        ":hover": {
          "color": {
            "background": "var:preset|color|button-primary-hover",
            "text": "var:preset|color|white"
          },
          "border": {
            "color": "var:preset|color|button-primary-hover"
          }
        },

        "variations": {
          "outline": {
            "title": "Outline",

            "color": {
              "background": "transparent",
              "text": "var:preset|color|button-primary"
            },

            "border": {
              "width": "1px",
              "style": "solid",
              "color": "var:preset|color|button-secondary-border",
              "radius": "0px"
            },

            "typography": {
              "fontSize": "var:preset|font-size|bioscope-x-small",
              "letterSpacing": "0.3em",
              "textTransform": "uppercase",
              "lineHeight": "1.3"
            },

            "spacing": {
              "padding": {
                "top": "13px",
                "right": "36px",
                "bottom": "13px",
                "left": "36px"
              }
            },

            ":hover": {
              "color": {
                "background": "var:preset|color|button-secondary-hover",
                "text": "var:preset|color|gold"
              },

              "border": {
                "color": "var:preset|color|button-secondary-border-hover"
              }
            }
          }
        }
      }
    }
  }
}
