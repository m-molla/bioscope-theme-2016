{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "bioscope/google-map",
  "version": "1.0.0",
  "title": "Google Map",
  "category": "widgets",
  "icon": "location-alt",
  "description": "Embed a responsive Google Map with adjustable width and height.",
  "textdomain": "bioscope-google-map-block",
  "attributes": {
    "location": { "type": "string", "default": "Dhaka, Bangladesh" },
    "embedUrl": { "type": "string", "default": "" },
    "width": { "type": "string", "default": "100%" },
    "height": { "type": "number", "default": 400 },
    "zoom": { "type": "number", "default": 14 },
    "borderRadius": { "type": "number", "default": 0 },
    "mapTitle": { "type": "string", "default": "Google Map" }
  },
  "supports": {
    "align": [ "wide", "full" ],
    "anchor": true,
    "html": false,
    "spacing": { "margin": true }
  },
  "editorScript": "file:./index.js",
  "style": "file:./style-index.css",
  "editorStyle": "file:./index.css"
}
